<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tonote.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!--
      Mac 设计稿 font 变量: -apple-system, "SF Pro Text", "PingFang SC", …
      Windows 侧用「微软雅黑 UI」承担中文（比普通雅黑更细、更适合 UI），
      Segoe UI 承担拉丁字符与数字，Inter 作为内嵌字体兜底。
      不设置这一项时 Avalonia 会回退到系统默认字体，中文显示为宋体，是「粗糙感」的最大来源。
    -->
    <FontFamily x:Key="TnFont">Microsoft YaHei UI, Segoe UI, Inter, PingFang SC, sans-serif</FontFamily>

    <!--
      自绘按钮外观：模板只对本地属性做 TemplateBinding，
      因此 FluentTheme 的 :pointerover 蓝灰底 / :pressed 深蓝 / 焦点虚线框都不会生效。
      hover 与 pressed 改为 0.12s 的透明度过渡，接近 macOS 的克制反馈。
    -->
    <ControlTheme x:Key="TnButton" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#1D1D1F" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}">
            <ContentPresenter.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
              </Transitions>
            </ContentPresenter.Transitions>
          </ContentPresenter>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.88" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.72" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.38" />
      </Style>
    </ControlTheme>

    <!-- Fluent 11.3 的 ComboBoxItem 高亮走这些资源画笔，普通 Style 改不动，这里精准覆盖 -->
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver">#E8F6EF</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected">#E6F4EC</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver">#D8EFE2</SolidColorBrush>
    <!-- 下拉面板：白底 + 更淡的描边，避免 WinUI 的默认灰框 -->
    <SolidColorBrush x:Key="ComboBoxDropDownBackground">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush">#E6E8EC</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- 全局排版：字号、字体族、字色由窗口继承到所有未显式指定的 TextBlock -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#1D1D1F" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Theme" Value="{StaticResource TnButton}" />
    </Style>
    <!-- 纯图标按钮（如任务删除）：hover/pressed 不做任何透明度或底色变化 -->
    <Style Selector="Button.plain-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.plain-icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- 输入框：去掉 WinUI 的蓝色 focus 边框，光标与选区换成主题绿 -->
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CaretBrush" Value="#1A9E5C" />
      <Setter Property="SelectionBrush" Value="#CFE9D9" />
      <Setter Property="SelectionForegroundBrush" Value="#1D1D1F" />
    </Style>
    <!-- FluentTheme 的 :focus 会给 TextBox 加 2px 深灰边框，这里彻底压掉 -->
    <Style Selector="TextBox:focus">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- 任务备注输入框：浅绿面板上编辑时内部保持白底（覆盖上面的 Transparent） -->
    <Style Selector="TextBox.notes-input /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="TextBox.notes-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
    </Style>
    <!-- 底部「添加任务」输入框：白底 + 浅灰边框，获得焦点后保持不变（覆盖上面 :focus 的透明/无边框） -->
    <Style Selector="TextBox.quick-add:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#86868B" />
    </Style>
    <Style Selector="TextBox.quick-add:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#86868B" />
    </Style>
    <!-- 笔记本下拉：浅灰胶囊、无 WinUI 蓝框，宽度由内容决定（见 ShellView 的 MinWidth=0） -->
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#1D1D1F" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#F2F2F4" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <!-- 下拉项：白底细分隔、圆角 hover/选中淡绿，与右键菜单一套语言 -->
    <Style Selector="ComboBoxItem">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#1D1D1F" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="#E8F6EF" />
      <Setter Property="Foreground" Value="#1D1D1F" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="#E6F4EC" />
      <Setter Property="Foreground" Value="#1D1D1F" />
    </Style>

    <!-- 细窄滚动条：Mac overlay scroller 的视觉，thumb 常驻但极淡 -->
    <Style Selector="ScrollBar:vertical">
      <Setter Property="Width" Value="9" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
      <Setter Property="Height" Value="9" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="#C9CCD4" />
    </Style>

    <!-- 左侧菜单栏滚动条：4px 宽、更浅、去掉上下箭头 -->
    <Style Selector="ScrollViewer.slim ScrollBar:vertical">
      <Setter Property="Width" Value="4" />
      <Setter Property="MinWidth" Value="4" />
    </Style>
    <Style Selector="ScrollViewer.slim ScrollBar /template/ RepeatButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollViewer.slim ScrollBar /template/ Thumb">
      <Setter Property="Background" Value="#DEDFE4" />
      <Setter Property="MinWidth" Value="4" />
    </Style>
    <Style Selector="ScrollViewer.slim ScrollBar:pointerover /template/ Thumb">
      <Setter Property="Background" Value="#CFD1D8" />
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb">
      <Setter Property="Background" Value="#A1A1A6" />
    </Style>

    <!-- 深色小气泡（设计稿 .tb .bubble / rgba(44,44,46,.95)） -->
    <Style Selector="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="Background" Value="#F22C2C2E" />
      <Setter Property="Padding" Value="7,4" />
    </Style>

    <!-- 所有窗口（主窗口、各类对话框、设置、使用说明）与弹出层（右键菜单 / 下拉 / 气泡）
         统一：微软雅黑 UI 字体 + 子像素抗锯齿 + 整像素对齐，避免文字出现锯齿或回退成宋体 -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style Selector="PopupRoot">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
    </Style>

    <!-- 右键菜单也用同一套字体 -->
    <Style Selector="MenuItem">
      <Setter Property="FontFamily" Value="{StaticResource TnFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#3A3A3C" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#E8F6EF" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#E8F6EF" />
    </Style>

    <!-- 右键菜单分隔线：Fluent 默认 1px 偏粗，统一细一半、颜色浅一档 -->
    <Style Selector="Separator">
      <Setter Property="Height" Value="0.5" />
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="Background" Value="#ECECEF" />
    </Style>

    <!-- 右键菜单浮层：白底、细边框、圆角、内边距 -->
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E6E8EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="148" />
    </Style>
  </Application.Styles>
</Application>
